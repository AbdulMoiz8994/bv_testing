        "jsCode": "// Map discovery results back onto every submitted page by site.\n// Reporting only: nothing found here is scanned. Scanning discovered pages is\n// what INPUT_SOURCE=SITEMAP SCAN does on the scheduled workflow.\nconst bySite = new Map();\n\nfor (const item of $input.all()) {\n  let parsed = null;\n  try {\n    parsed = JSON.parse(item.json.stdout || \"{}\");\n  } catch (e) {\n    parsed = null;\n  }\n  const origin = item.json.origin || parsed?.discoveredUrls?.[0]?.url || null;\n  if (origin) bySite.set(origin, parsed);\n}\n\nreturn $(\"Prepare URLs & Context\").all().map((seed) => {\n  let origin = null;\n  try {\n    origin = new URL(seed.json.url).origin;\n  } catch (e) {\n    origin = null;\n  }\n  const found = origin ? bySite.get(origin) : null;\n\n  return {\n    json: {\n      ...seed.json,\n      context: {\n        ...seed.json.context,\n        discovery_summary: found?.discoverySummary || null,\n        discovered_urls: found?.discoveredUrls || [],\n        discovered_subdomains: found?.discoveredSubdomains || [],\n      },\n    },\n  };\n});\n"
      },
      "type": "n8n-nodes-base.code",
