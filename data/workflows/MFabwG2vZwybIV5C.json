      "id": "d200594e-6912-4191-bd71-f187b35b2a94",
      "name": "Merge Discovery Result"
    },
    {
      "parameters": {
        "jsCode": "// One discovery run per site, not per page. A client ordering 25 pages on one\n// domain would otherwise trigger 25 identical sitemap reads, each able to run\n// for DISCOVERY_MAX_SECONDS.\nconst seen = new Map();\n\nfor (const item of $input.all()) {\n  let origin;\n  try {\n    origin = new URL(item.json.url).origin;\n  } catch (e) {\n    continue;\n  }\n  if (!seen.has(origin)) {\n    seen.set(origin, { json: { origin, url: origin, submittedUrls: [] } });\n  }\n  // Collected so the discovery script can mark which discovered pages were\n  // actually submitted (inScope), rather than every page reporting false.\n  seen.get(origin).json.submittedUrls.push(item.json.url);\n}\n\nreturn Array.from(seen.values());\n"
      },
      "type": "n8n-nodes-base.code",
