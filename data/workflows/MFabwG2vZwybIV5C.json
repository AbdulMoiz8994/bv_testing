      "parameters": {
        "jsCode": "function uuidv4() {\n  return \"xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx\".replace(/[xy]/g, (c) => {\n    const r = (Math.random() * 16) | 0;\n    const v = c === \"x\" ? r : (r & 0x3) | 0x8;\n    return v.toString(16);\n  });\n}\n\nfunction isPlainObject(o) {\n  return o && typeof o === \"object\" && !Array.isArray(o);\n}\n\nconst body = $json.body ?? $json;\n\nlet urlList = [];\nif (Array.isArray(body.urls)) urlList = body.urls;\nelse if (typeof body.url === \"string\") urlList = [body.url];\n\nurlList = urlList\n  .filter((u) => typeof u === \"string\" && u.trim())\n  .map((u) => u.trim());\n\nif (!urlList.length) {\n  throw new Error('Payload must include \"urls\" (array) or \"url\" (string).');\n}\n\n// De-duplicate, cap by MAX_URLS\nconst max = parseInt($env.MAX_URLS || \"100\", 10);\nconst seen = new Set();\nconst urls = urlList\n  .filter((u) => {\n    const key = u.toLowerCase();\n    if (seen.has(key)) return false;\n    seen.add(key);\n    return true;\n  })\n  .slice(0, max);\n\nconst baseContext = isPlainObject(body.context) ? body.context : {};\nconst complianceProfile = body.complianceProfile || body.compliance_profile || '';\nconst { urls: _urls, url: _url, context: _context, complianceProfile: _cp, compliance_profile: _cp2, ...rest } = body;\n\nconst runId = uuidv4();\nconst startedAt = new Date().toISOString();\n\nreturn urls.map((u, i) => ({\n  json: {\n    url: u,\n    context: {\n      ...baseContext,\n      ...rest,\n      run_id: runId,\n      index: i,\n      total: urls.length,\n      started_at: startedAt,\n      complianceProfile: complianceProfile,\n    },\n  },\n}));\n"
      },
