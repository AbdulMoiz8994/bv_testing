        "jsCode": "const item = $json;\n\nreturn [\n  {\n    json: {\n      run_id: item.run_id?.[0] || \"\",\n      started_at: item.started_at?.[0] || \"\",\n      completed_at: new Date().toISOString(),\n      urls: item.urls?.length || 0,\n      violations: (item.violations || []).reduce(\n        (a, b) => a + Number(b || 0),\n        0,\n      ),\n      high_impact: (item.high_impact || []).reduce(\n        (a, b) => a + Number(b || 0),\n        0,\n      ),\n      ai_cost_usd: (item.ai_cost_usd || []).reduce(\n        (a, b) => a + Number(b || 0),\n        0,\n      ),\n      failures: (item.failures || []).reduce((a, b) => a + Number(b || 0), 0),\n      notes: (item.notes || []).filter(Boolean).join(\" | \").slice(0, 900),\n    },\n  },\n];\n"
