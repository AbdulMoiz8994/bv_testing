      "parameters": {
        "jsCode": "function uuidv4() {\n  return \"xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx\".replace(/[xy]/g, (c) => {\n    const r = (Math.random() * 16) | 0;\n    const v = c === \"x\" ? r : (r & 0x3) | 0x8;\n    return v.toString(16);\n  });\n}\n\nconst rows = $input.all().map(i => i.json).filter(r => r && r.url);\n\nconst runId = uuidv4();\nconst startedAt = new Date().toISOString();\nconst total = rows.length;\n\nreturn rows.map((r, i) => ({\n  json: {\n    url: String(r.url).trim(),\n    context: {\n      site: String(r.site || \"\").trim(),\n      priority: String(r.priority || \"\").trim(),\n      owner: String(r.owner || \"\").trim(),\n      run_id: runId,\n      index: i,\n      total,\n      started_at: startedAt,\n      complianceProfile: String(r.complianceProfile || r.compliance_profile || '').trim(),\n      // Present only when INPUT_SOURCE is SITEMAP SCAN. Carried so the report\n      // can render the discovery section when it is enabled.\n      discovery_summary: r.discovery_summary || null,\n      discovered_subdomains: r.discovered_subdomains || [],\n      discovered_from: r.discovered_from || null\n    }\n  }\n}));\n"
      },
