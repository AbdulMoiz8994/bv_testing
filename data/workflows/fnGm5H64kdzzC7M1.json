    {
      "parameters": {
        "command": "=node /data/scripts/run-discovery.js \"{{ $json.url }}\""
      },
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        -2064,
        96
      ],
      "id": "f766722f-a971-4d15-bf2f-b57144ada2dc",
      "name": "Discover URLs from Sitemap",
      "notesInFlow": true,
      "notes": "Reads robots.txt and the sitemap. Does not crawl links. Capped by MAX_URLS.",
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// Expand each seed row into the URLs its sitemap publishes.\n// Discovery never blocks a run: if it finds nothing, or fails, the seed URL is\n// scanned on its own exactly as it would be under INPUT_SOURCE=SHEET.\nconst MAX = parseInt($env.MAX_URLS || \"100\", 10);\nconst out = [];\nconst seen = new Set();\n\nfor (const item of $input.all()) {\n  const seedRow = $(\"Edit Fields (Sitemap)\").all().find(\n    (r) => r.json && r.json.url\n  );\n  const seed = item.json.seed || (seedRow ? seedRow.json : {});\n\n  let result = null;\n  try {\n    result = JSON.parse(item.json.stdout || \"{}\");\n  } catch (e) {\n    result = null;\n  }\n\n  const discovered = Array.isArray(result?.discoveredUrls)\n    ? result.discoveredUrls.map((u) => u.url).filter(Boolean)\n    : [];\n\n  const list = discovered.length > 0 ? discovered : [seed.url].filter(Boolean);\n\n  for (const u of list) {\n    const key = String(u).toLowerCase();\n    if (seen.has(key)) continue;\n    seen.add(key);\n    if (out.length >= MAX) break;\n    out.push({\n      json: {\n        url: u,\n        site: seed.site || \"\",\n        priority: seed.priority || \"\",\n        owner: seed.owner || \"\",\n        complianceProfile: seed.complianceProfile || \"\",\n        discovery_summary: result?.discoverySummary || null,\n        discovered_subdomains: result?.discoveredSubdomains || [],\n        discovered_from: seed.url || null,\n      },\n    });\n  }\n  if (out.length >= MAX) break;\n}\n\nreturn out;\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1840,
        96
      ],
      "id": "73a64454-4267-4e49-9860-39b9eef6a6a1",
      "name": "Expand Discovered URLs",
      "notesInFlow": true,
      "notes": "Falls back to the seed URL when discovery finds nothing."
    }
