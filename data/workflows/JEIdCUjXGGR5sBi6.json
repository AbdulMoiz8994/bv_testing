    {
      "parameters": {
        "sendTo": "={{ $env.ALERT_EMAIL_TO }}",
        "subject": "=\ud83d\udea8 [n8n Error] Workflow {{ $json[\"workflow\"][\"name\"] }} failed at node {{ $json[\"execution\"][\"lastNodeExecuted\"] }}",
        "message": "=<!DOCTYPE html>\n<html>\n  <body style=\"font-family: Arial, sans-serif; color: #333; line-height: 1.5; margin: 0; padding: 20px;\">\n    <h2 style=\"color: #d9534f; margin-bottom: 10px;\">\ud83d\udea8 Workflow Execution Failed</h2>\n    <p style=\"color: #555; margin-top: 0;\">An error occurred during workflow execution.</p>\n\n    <!-- Workflow Info -->\n    <h3 style=\"margin-top: 20px;\">\ud83d\udccc Workflow Info</h3>\n    <table style=\"border-collapse: collapse; width: 100%; max-width: 600px;\">\n      <tr><td><b>Name:</b></td><td>{{ $json[\"workflow\"]?.[\"name\"] || \"N/A\" }}</td></tr>\n      <tr><td><b>ID:</b></td><td>{{ $json[\"workflow\"]?.[\"id\"] || \"N/A\" }}</td></tr>\n    </table>\n\n    <!-- Execution Info -->\n    <h3 style=\"margin-top: 20px;\">\u2699\ufe0f Execution Info</h3>\n    <table style=\"border-collapse: collapse; width: 100%; max-width: 600px;\">\n      <tr><td><b>Execution ID:</b></td><td>{{ $json[\"execution\"]?.[\"id\"] || \"N/A\" }}</td></tr>\n      <tr><td><b>Node:</b></td><td>{{ $json[\"execution\"]?.[\"lastNodeExecuted\"] || \"N/A\" }}</td></tr>\n      <tr><td><b>Mode:</b></td><td>{{ $json[\"execution\"]?.[\"mode\"] || \"N/A\" }}</td></tr>\n      <tr><td><b>Started At:</b></td><td>  {{ $json.execution?.error?.timestamp \n    ? new Date($json.execution.error.timestamp).toISOString() \n    : \"N/A\" }}</td></tr>\n      <tr>\n        <td><b>Details:</b></td>\n        <td>\n          <a href=\"{{ $json[\"execution\"]?.[\"url\"] || \"#\" }}\" target=\"_blank\" style=\"color:#d9534f;\">\n            {{ $json[\"execution\"]?.[\"url\"] ? \"View Execution in n8n\" : \"No execution URL available\" }}\n          </a>\n        </td>\n      </tr>\n    </table>\n\n    <!-- Error Details -->\n    <h3 style=\"margin-top: 20px;\">\u274c Error Details</h3>\n    <p><b>Type:</b> {{ $json[\"execution\"]?.[\"error\"]?.[\"name\"] || \"Unknown Error\" }}</p>\n    <p><b>Message:</b></p>\n    <pre style=\"background:#fdf2f2; padding:10px; border:1px solid #f5c2c7; border-radius:4px; white-space: pre-wrap;\">\n{{ $json[\"execution\"]?.[\"error\"]?.[\"message\"] || \"No error message available\" }}\n    </pre>\n\n    <!-- Stack Trace -->\n    <h3 style=\"margin-top: 20px;\">\ud83d\udcc4 Stack Trace (for debugging)</h3>\n    <pre style=\"background:#f8f9fa; padding:10px; border:1px solid #ddd; border-radius:4px; font-size:12px; white-space: pre-wrap;\">\n{{ $json[\"execution\"]?.[\"error\"]?.[\"stack\"] || \"No stack trace available\" }}\n    </pre>\n  </body>\n</html>",
